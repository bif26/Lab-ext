{
  "manifest_version": 3,
  "name": "LanguageShadow Offline",
  "version": "1.5.0",
  "description": "AI Pronunciation Feedback & Shadowing for YouTube (Offline)",
  "author": "Local",
  "browser_specific_settings": {
    "gecko": {
      "id": "languageshadow@offline.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": ["src/background/index.js"]
  },
  "action": {
    "default_title": "LanguageShadow – click to open/close the panel",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/index.html",
    "default_title": "LanguageShadow",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open/close the LanguageShadow panel"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8765/*"
  ]
}
