{
  "manifest_version": 3,
  "name": "LanguageShadow Offline",
  "version": "1.1.4",
  "description": "AI Pronunciation Feedback & Shadowing for YouTube (Offline)",
  "author": "Local",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LanguageShadow"
  },
  "background": {
    "scripts": ["src/background/index.js"],
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8000/",
    "http://127.0.0.1:8765/"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "languageshadow@your-email.com"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:8000 http://127.0.0.1:8765; default-src 'self';"
  }
}
